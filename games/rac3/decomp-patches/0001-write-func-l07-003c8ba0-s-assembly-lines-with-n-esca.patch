From: Flavius <45127244+Veradictus@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:26:08 -0600
Subject: Write func_L07_003C8BA0's assembly lines with \n escapes

Its inline assembly strings ran across raw line breaks, which GCC 2.95
reads as part of the string and Clang rejects, so hostgen cannot read
L07_003C7468.c. The same text, so the same code: every function in the
file still matches.
---
 src/levels/07_annihilation_nation/L07_003C7468.c | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/src/levels/07_annihilation_nation/L07_003C7468.c b/src/levels/07_annihilation_nation/L07_003C7468.c
index 65cf3b6..835f9d5 100644
--- a/src/levels/07_annihilation_nation/L07_003C7468.c
+++ b/src/levels/07_annihilation_nation/L07_003C7468.c
@@ -745,14 +745,10 @@ void func_L07_003C8BA0(u8 *obj)
     u8 *p = *(u8 **)(obj + 0x68);
     p[0x4D7] = 0;
     __asm__ (
-        "lqc2 $vf1, 0x130(%1)
-"
-        "lqc2 $vf2, 0x10(%2)
-"
-        "vsub.xyz $vf2, $vf2, $vf1
-"
-        "sqc2 $vf2, %0
-"
+        "lqc2 $vf1, 0x130(%1)\n"
+        "lqc2 $vf2, 0x10(%2)\n"
+        "vsub.xyz $vf2, $vf2, $vf1\n"
+        "sqc2 $vf2, %0\n"
         : "=m" (delta) : "r" (p), "r" (obj) : "vf1", "vf2", "memory");
     if (func_0038CE68(&delta.x, (f32 *)(obj + 0xD0)) >= 0.0f) {
         p[0x4DC] = 1;
