# Style rules are in docs/STYLE.md. Run tools/format.py, which pins the version and checks the result.
Language: C
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
ContinuationIndentWidth: 4

BreakBeforeBraces: Attach
PointerAlignment: Right
DerivePointerAlignment: false
IndentCaseLabels: true
AlignAfterOpenBracket: Align
AlignEscapedNewlines: Left
AlignTrailingComments:
  Kind: Leave
SpacesBeforeTrailingComments: 1
MaxEmptyLinesToKeep: 2
InsertNewlineAtEOF: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# The tools read a function's type and name from one line.
BreakAfterReturnType: Automatic
PenaltyReturnTypeOnItsOwnLine: 100000

# Comments are credit and notes: never reflow them. Strings are matched bytes: never split them.
ReflowComments: false
BreakStringLiterals: false

# Include order matters: include/names.h macros depend on it.
SortIncludes: Never

StatementMacros: [INCLUDE_ASM, INCLUDE_RODATA, ASM_FUNC, LINKER_REMNANT]
AttributeMacros: [SDATA, NOT_SDA, MACRO_ADDR]
