From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Pezza <7693062+pezzadev@users.noreply.github.com>
Date: Sun, 22 Nov 2026 23:22:37 +0000
Subject: mark interpolated texture uploads

Mark interpolated texture uploads as generated.

Keep the game's interpolated effect frames out of texture-pack dumps without dropping their draw.

---
 src/overlays/shared/rendering/build_interpolated_dma_packet.c | 4 ++++
 src/overlays/l09/draw_level09_textured_surfaces.c | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/src/overlays/shared/rendering/build_interpolated_dma_packet.c b/src/overlays/shared/rendering/build_interpolated_dma_packet.c
--- a/src/overlays/shared/rendering/build_interpolated_dma_packet.c
+++ b/src/overlays/shared/rendering/build_interpolated_dma_packet.c
@@ -559,6 +559,10 @@
     words[6] = color;
     words[7] = 0x3D;
     words[8] = (long)(TEXTURE_CURSOR >> 8) << 32 | 0x1000000000000;
+#ifdef OPENRAC_HOSTGEN
+    /* OpenRAC marks this interpolated image in a reserved BITBLTBUF bit. */
+    words[8] |= 0x8000000000000000ULL;
+#endif
     words[9] = 0x50;
     words[10] = 0;
     words[11] = 0x51;
diff --git a/src/overlays/l09/draw_level09_textured_surfaces.c b/src/overlays/l09/draw_level09_textured_surfaces.c
--- a/src/overlays/l09/draw_level09_textured_surfaces.c
+++ b/src/overlays/l09/draw_level09_textured_surfaces.c
@@ -88,6 +88,10 @@
         words[2] = (long)(TEXTURE_CURSOR >> 8) | 0x18100000 | (0xB000L << 19);
         words[3] = 6;
         words[4] = (long)(TEXTURE_CURSOR >> 8) << 32 | 0x1000000000000L;
+#ifdef OPENRAC_HOSTGEN
+        /* OpenRAC marks this interpolated image in a reserved BITBLTBUF bit. */
+        words[4] |= 0x8000000000000000ULL;
+#endif
         words[5] = 0x50;
         words[6] = 0;
         words[7] = 0x51;
