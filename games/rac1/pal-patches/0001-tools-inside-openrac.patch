 tools/docker/run.sh   | 10 +++++++++-
 tools/dossier.py      |  4 ++--
 tools/lombyte.py      | 17 ++++++++++++-----
 tools/names.py        |  6 +++---
 tools/old/fcheck.py   |  8 ++++----
 tools/overlay_scan.py |  2 +-
 tools/overlays.py     |  2 +-
