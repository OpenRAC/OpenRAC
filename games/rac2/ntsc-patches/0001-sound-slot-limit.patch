Date: Mon, 2 Nov 2026 09:15:17 +0000
Subject: sound slot limit

Stop at the last of the 52 sound channel slots.

func_002E5A50 returns 52 when no slot is free; retail then writes past the 52 rows.
The slot is -1 then.
---
 src/game/002B6120-sound-g8.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/game/002B6120-sound-g8.c b/src/game/002B6120-sound-g8.c
index 78ee559..8b3946e 100644
--- a/src/game/002B6120-sound-g8.c
+++ b/src/game/002B6120-sound-g8.c
@@ -125,6 +125,8 @@ void func_002B6958(int id, int mode, void *object, int volume)
     STATE->channel[1].crossfade = 0;
     STATE->channel[1].object = object;
     STATE->channel[1].slot = func_002E5A50(object);
+    if (STATE->channel[1].slot >= 52) /* no free slot: retail would write past the 52 rows */
+        STATE->channel[1].slot = -1;
     if (STATE->channel[1].slot >= 0) {
         slot = STATE->channel[1].slot;
         sound = (SoundAnchor *)(D_00188660 + slot * 0x70);
