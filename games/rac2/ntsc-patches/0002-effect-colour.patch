+++ b/src/game/002E7BC8-g8.c
@@ -30,6 +30,12 @@ void func_002E7BC8(void *object)
  char *o = object;
  unsigned long long next;
  unsigned int color;
+ /* OpenRAC: as in func_002E76C0, the new records' colour and alpha now (+0x30, +0x38) are drawn once as
