{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenRAC Launcher",
  "version": "0.1.0",
  "identifier": "dev.openrac.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenRAC Launcher",
        "width": 1200,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#181820"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
