{
  "name": "rac5/ntsc",
  "about": "Size Matters USA isolated level C. Canonical source routes and every recorded placement; no source-tree writes. Whole-program promotion remains separate.",
  "checkout": ["rac5", "ntsc"],
  "python": ["python3"],
  "sources": ["{RAC5_SOURCE_GLOB}"],
  "asm": ["{RAC5_RETAIL_DIR}/{func}.s"],
  "word_order": "word",
  "cpp": ["gcc", "-E", "-P", "-I", "{checkout}/include", "-I", "{srcdir}"],
  "flags": ["{python}", "{RAC5_BACKEND}", "--repo", "{checkout}", "--runtime", "{RAC5_MATCH_RUNTIME}", "flags", "--function", "{func}", "--source-key", "{source}"],
  "compile": [["{python}", "{RAC5_BACKEND}", "--repo", "{checkout}", "--runtime", "{RAC5_MATCH_RUNTIME}", "compile", "--function", "{func}", "--source-key", "{source}", "--candidate", "{spliced}", "--out", "{out}"]],
  "check": ["{python}", "{RAC5_BACKEND}", "--repo", "{checkout}", "--runtime", "{RAC5_MATCH_RUNTIME}", "check", "--function", "{func}", "--candidate", "{spliced}", "--out", "{out}"],
  "check_in_place": false,
  "exact": "^{func}: EXACT ([1-9][0-9]*) placements$",
  "weights": {
    "perm_temp_for_expr": 0,
    "perm_expand_expr": 0,
    "perm_reorder_stmts": 0,
    "perm_reorder_decls": 0,
    "perm_add_mask": 0,
    "perm_xor_zero": 0,
    "perm_cast_simple": 0,
    "perm_refer_to_var": 0,
    "perm_float_literal": 0,
    "perm_randomize_internal_type": 0,
    "perm_randomize_external_type": 0,
    "perm_randomize_function_type": 0,
    "perm_split_assignment": 0,
    "perm_sameline": 0,
    "perm_ins_block": 0,
    "perm_struct_ref": 0,
    "perm_empty_stmt": 0,
    "perm_condition": 0,
    "perm_mult_zero": 0,
    "perm_factor_mult": 0,
    "perm_factor_shift": 0,
    "perm_dummy_comma_expr": 0,
    "perm_add_self_assignment": 0,
    "perm_commutative": 0,
    "perm_add_sub": 0,
    "perm_inequalities": 0,
    "perm_compound_assignment": 0,
    "perm_remove_ast": 0,
    "perm_duplicate_assignment": 0,
    "perm_chain_assignment": 0,
    "perm_long_chain_assignment": 0,
    "perm_pad_var_decl": 0,
    "perm_inline": 0,
    "perm_var_cond_block": 0,
    "perm_alias_array": 0,
    "perm_remove_var": 0,
    "perm_reverse_cond": 1
  },
  "max_candidates": 3,
  "keep_work": true,
  "notes": "Requires the RAC5 backend, an external runtime configuration, a precise source glob and prepared private retail assembly. Level C only; no automatic promotion.",
  "candidate_ceiling": 3,
  "asm_passes": false
}
