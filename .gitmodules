# The decompilation projects OpenRAC builds on, each at the commit games/<game>/game.json records.
# OpenRAC's own changes to them live beside each one, in <version>-patches/, and
# `python3 tools/sources.py apply` puts them in place (docs/SOURCES.md).
[submodule "games/rac1/pal"]
	path = games/rac1/pal
	url = https://github.com/OpenRAC/rac1-decomp.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac1/ntsc"]
	path = games/rac1/ntsc
	url = https://github.com/lombyte-project/Lombyte.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac2/ntsc"]
	path = games/rac2/ntsc
	url = https://github.com/OpenRAC/rac2-decomp.git
	branch = master
	shallow = true
	ignore = dirty
[submodule "games/rac3/ntsc"]
	path = games/rac3/ntsc
	url = https://github.com/OpenRAC/rac3-uya-decomp.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac4/ntsc"]
	path = games/rac4/ntsc
	url = https://github.com/OpenRAC/rac-deadlocked-decomp.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac5/ntsc"]
	path = games/rac5/ntsc
	url = https://github.com/OpenRAC/rac5-sm-decomp.git
	branch = master
	shallow = true
	ignore = dirty
[submodule "games/rac6/ntsc"]
	path = games/rac6/ntsc
	url = https://github.com/OpenRAC/rac-sac-decomp.git
	branch = main
	shallow = true
	ignore = dirty
