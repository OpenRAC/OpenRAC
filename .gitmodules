# The decompilation projects OpenRAC builds on, each at the commit games/<game>/game.json records.
# OpenRAC's own changes to them live beside each one, in decomp-patches/ (or <version>-patches/), and
# `python3 tools/sources.py apply` puts them in place (docs/SOURCES.md).
[submodule "games/rac1/decomp"]
	path = games/rac1/decomp
	url = https://github.com/OpenRAC/rac1-decomp.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac1/ntsc-decomp"]
	path = games/rac1/ntsc-decomp
	url = https://github.com/lombyte-project/Lombyte.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac2/decomp"]
	path = games/rac2/decomp
	url = https://github.com/OpenRAC/rac2-decomp.git
	branch = master
	shallow = true
	ignore = dirty
[submodule "games/rac3/decomp"]
	path = games/rac3/decomp
	url = https://github.com/OpenRAC/rac3-decomp.git
	branch = master
	shallow = true
	ignore = dirty
[submodule "games/rac4/decomp"]
	path = games/rac4/decomp
	url = https://github.com/OpenRAC/rac4-decomp.git
	branch = main
	shallow = true
	ignore = dirty
[submodule "games/rac5/decomp"]
	path = games/rac5/decomp
	url = https://github.com/OpenRAC/rac5-sm-decomp.git
	branch = master
	shallow = true
	ignore = dirty
[submodule "games/rac6/decomp"]
	path = games/rac6/decomp
	url = https://github.com/OpenRAC/rac-sac-decomp.git
	branch = main
	shallow = true
	ignore = dirty
