#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
// Cull probe volumes against each screen tile's depth range.
layout(local_size_x = 16, local_size_y = 16) in;

// Per region: origin/atlas offset, spacing, then dimensions.
layout(std140) uniform ProbeRegions {
    vec4 regions[3072];
};

// Count, 128 global IDs, then four words per tile for opaque and depth-independent masks.
layout(std430, binding = 8) buffer TileMasks {
    uint masks[];
};

#ifndef OPENRAC_PROBE_SHORTLIST
uniform sampler2D scene_depth;
#endif
uniform mat4 world_to_clip;
uniform int region_count;
#if !defined(OPENRAC_PROBE_SHORTLIST) && !defined(OPENRAC_PROBE_TILES)
uniform int select_regions;
#endif
uniform int translucent_tiles;
uniform vec3 camera_position;


vec2 region_axis(uint id) { vec2 a=vec2(regions[id*3+1].w,regions[id*3+2].w);return dot(a,a)>.5?a:vec2(1,0); }
vec3 region_local(uint id,vec3 p) { vec2 a=region_axis(id);return vec3(dot(p.xy,a),dot(p.xy,vec2(-a.y,a.x)),p.z); }
bool intersects_region(uint id, vec4 frustum[6]) {
    vec3 lo = regions[id * 3].xyz;
    vec3 size = regions[id * 3 + 1].xyz * (regions[id * 3 + 2].xyz - 1.0);
    for (int p = 0; p < 6; ++p) {
        vec4 plane = frustum[p];
        vec3 local_plane=region_local(id,plane.xyz);
        float support=dot(plane,vec4(lo,1))+dot(max(local_plane,vec3(0)),size);
        if (support < -0.001 * length(plane.xyz)) return false;
    }
    return true;
}

#ifndef OPENRAC_PROBE_TILES
shared float distances[1024];
shared uint indices[1024];
// One workgroup sorts all 1024 keys, with stable region IDs breaking distance ties.
void select_closest(uint lane) {
    mat4 t = transpose(world_to_clip);
    vec4 frustum[6] = vec4[6](t * vec4(1,0,0,1), t * vec4(-1,0,0,1),
        t * vec4(0,1,0,1), t * vec4(0,-1,0,1), t * vec4(0,0,1,1), t * vec4(0,0,-1,1));
    for (uint id = lane; id < 1024u; id += 256u) {
        float distance = uintBitsToFloat(0x7f800000u);
        if (id < uint(region_count) && intersects_region(id, frustum)) {
            vec3 lo = regions[id * 3].xyz;
            vec3 size = regions[id * 3 + 1].xyz * (regions[id * 3 + 2].xyz - 1.0);
            vec3 local=region_local(id,camera_position-lo);
            vec3 delta = local - clamp(local,vec3(0),size);
            distance = dot(delta, delta);
        }
        distances[id] = distance;
        indices[id] = id;
    }
    barrier();
    for (uint size = 2u; size <= 1024u; size <<= 1u) {
        for (uint stride = size >> 1u; stride > 0u; stride >>= 1u) {
            // Each lane handles two disjoint pairs before the shared-memory barrier.
            for (uint pair = lane; pair < 512u; pair += 256u) {
                uint a = (pair / stride) * (stride * 2u) + pair % stride;
                uint b = a + stride;
                bool greater = distances[a] > distances[b]
                    || (distances[a] == distances[b] && indices[a] > indices[b]);
                bool less = distances[a] < distances[b]
                    || (distances[a] == distances[b] && indices[a] < indices[b]);
                if (((a & size) == 0u && greater) || ((a & size) != 0u && less)) {
                    float d = distances[a]; distances[a] = distances[b]; distances[b] = d;
                    uint i = indices[a]; indices[a] = indices[b]; indices[b] = i;
                }
            }
            barrier();
        }
    }
    if (lane < 128u) masks[1u + lane] = indices[lane];
    if (lane == 0u) {
        uint count = 0u;
        while (count < 128u && !isinf(distances[count])) ++count;
        masks[0] = count;
    }
}
#endif
#ifndef OPENRAC_PROBE_SHORTLIST
shared uint minimum_depth, maximum_depth;
shared uint hit_words[4];
shared vec4 planes[6];

#endif

void main() {
    uint lane = gl_LocalInvocationIndex;
#ifdef OPENRAC_PROBE_SHORTLIST
    select_closest(lane);
#else
#ifndef OPENRAC_PROBE_TILES
    if (select_regions != 0) { select_closest(lane); return; }
#endif
    ivec2 extent = textureSize(scene_depth, 0);
    ivec2 begin = ivec2(gl_WorkGroupID.xy) * 16;
    ivec2 end = min(begin + 16, extent);
    ivec2 pixel = begin + ivec2(gl_LocalInvocationID.xy);
    if (lane == 0) {
        minimum_depth = floatBitsToUint(1.0);
        maximum_depth = 0u;
    }
    if (lane < 4) {
        hit_words[lane] = 0u;
    }
    barrier();
    if (all(lessThan(pixel, extent))) {
        float d = texelFetch(scene_depth, pixel, 0).r;
        if (d > 0.0) {
            atomicMin(minimum_depth, floatBitsToUint(d));
            atomicMax(maximum_depth, floatBitsToUint(d));
        }
    }
    barrier();
    // A blended receiver may occupy any depth, including tiles with no opaque geometry.
    // Preserve global selection/order; only reject regions outside the tile's side planes.
    if (translucent_tiles != 0) {
        if (lane == 0) {
            vec2 lo = vec2(begin) / vec2(extent) * 2.0 - 1.0;
            vec2 hi = vec2(end) / vec2(extent) * 2.0 - 1.0;
            mat4 transform = transpose(world_to_clip);
            planes[0] = transform * vec4(1, 0, 0, -lo.x);
            planes[1] = transform * vec4(-1, 0, 0, hi.x);
            planes[2] = transform * vec4(0, 1, 0, -lo.y);
            planes[3] = transform * vec4(0, -1, 0, hi.y);
            planes[4] = planes[5] = vec4(0);
        }
        barrier();
        if (lane < masks[0] && intersects_region(masks[1u + lane], planes)) {
            atomicOr(hit_words[lane / 32], 1u << (lane % 32));
        }
        barrier();
        if (lane < 4u) {
            uint tiles_x = uint((extent.x + 15) / 16);
            uint tiles_y = uint((extent.y + 15) / 16);
            uint tile = gl_WorkGroupID.y * tiles_x + gl_WorkGroupID.x;
            masks[129u + (tiles_x * tiles_y + tile) * 4u + lane] = hit_words[lane];
            hit_words[lane] = 0u;
        }
        barrier();
    }
    // Uniform branch: partial/empty tiles never strand lanes before a barrier.
    if (maximum_depth != 0u) {
        if (lane == 0) {
            vec2 lo = vec2(begin) / vec2(extent) * 2.0 - 1.0;
            vec2 hi = vec2(end) / vec2(extent) * 2.0 - 1.0;
            mat4 transform = transpose(world_to_clip);
            planes[0] = transform * vec4(1, 0, 0, -lo.x);
            planes[1] = transform * vec4(-1, 0, 0, hi.x);
            planes[2] = transform * vec4(0, 1, 0, -lo.y);
            planes[3] = transform * vec4(0, -1, 0, hi.y);
            planes[4] = transform * vec4(0, 0, 1, -(uintBitsToFloat(minimum_depth) * 2.0 - 1.0));
            planes[5] = transform * vec4(0, 0, -1, uintBitsToFloat(maximum_depth) * 2.0 - 1.0);
        }
        barrier();
        if (lane < masks[0] && intersects_region(masks[1u + lane], planes)) {
            atomicOr(hit_words[lane / 32], 1u << (lane % 32));
        }
        barrier();
    }
    uint words = 4u;
    uint tiles_x = uint((extent.x + 15) / 16);
    uint tile = gl_WorkGroupID.y * tiles_x + gl_WorkGroupID.x;
    if (lane < words) {
        masks[129u + tile * words + lane] = hit_words[lane];
    }
#endif
}
