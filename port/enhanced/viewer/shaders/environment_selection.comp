#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
// Transparent reflection receivers require the full tile frustum, without opaque depth bounds.
layout(local_size_x=32) in;
layout(std430,binding=8) buffer EnvironmentTiles { uint tile_masks[]; };
uniform samplerBuffer capture_boxes;
uniform int capture_count;
uniform mat4 world_to_clip;
uniform vec2 tile_extent;
shared uint candidates[16];
void main() {
    uint lane=gl_LocalInvocationIndex;
    if(lane<16u) candidates[lane]=0u;
    barrier();
    vec2 begin=vec2(gl_WorkGroupID.xy)*16.;
    vec2 lo=begin/tile_extent*2.-1.;
    vec2 hi=min(begin+16.,tile_extent)/tile_extent*2.-1.;
    mat4 transform=transpose(world_to_clip);
    vec4 planes[4]=vec4[4](transform*vec4(1,0,0,-lo.x),transform*vec4(-1,0,0,hi.x),
                          transform*vec4(0,1,0,-lo.y),transform*vec4(0,-1,0,hi.y));
    for(uint id=lane;id<uint(capture_count);id+=32u) {
        // Water selects the camera-facing medium up to half a world unit from its surface.
        vec3 minimum=texelFetch(capture_boxes,int(id*5u+1u)).xyz-.5;
        vec3 maximum=texelFetch(capture_boxes,int(id*5u+2u)).xyz+.5;
        vec2 axis=vec2(texelFetch(capture_boxes,int(id*5u)).w,texelFetch(capture_boxes,int(id*5u+1u)).w);
        if(dot(axis,axis)<.5) axis=vec2(1,0);
        bool intersects=true;
        for(int p=0;p<4;++p) {
            vec3 normal=vec3(dot(planes[p].xy,axis),dot(planes[p].xy,vec2(-axis.y,axis.x)),planes[p].z);
            vec3 support=mix(minimum,maximum,greaterThanEqual(normal,vec3(0)));
            if(dot(normal,support)+planes[p].w < -.001*length(planes[p].xyz)) intersects=false;
        }
        if(intersects) atomicOr(candidates[id/32u],1u<<(id%32u));
    }
    barrier();
    uint tiles_x=uint((int(tile_extent.x)+15)/16);
    uint begin_word=(gl_WorkGroupID.y*tiles_x+gl_WorkGroupID.x)*17u;
    if(lane<16u) tile_masks[begin_word+1u+lane]=candidates[lane];
    if(lane==0u) {
        uint words=0u;
        for(uint i=0u;i<16u;++i) if(candidates[i]!=0u) words|=1u<<i;
        tile_masks[begin_word]=words;
    }
}
