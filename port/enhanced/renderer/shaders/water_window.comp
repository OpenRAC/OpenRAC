#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
layout(local_size_x=64) in;
layout(std430,binding=2) readonly buffer Coast {vec4 coast[];};
layout(std430,binding=3) readonly buffer Bodies {vec4 bodies[];};
layout(std430,binding=6) readonly buffer Hydraulics {vec4 hydraulics[];};
layout(std430,binding=0) writeonly buffer StateA {vec4 state_a[];};
layout(std430,binding=1) writeonly buffer StateB {vec4 state_b[];};
layout(std430,binding=7) buffer LocalCoast {vec4 local_coast[];};
layout(std430,binding=8) writeonly buffer LocalHydraulics {vec4 local_hydraulics[];};
uniform vec4 window_config;
uniform int water_body_count;
uniform float water_sim_height;
uniform int initialize_history;
uniform vec2 previous_window;
uniform float water_current_scale;
int water_baked_cell(vec2 p,int index) {
    int body=index*5;
    ivec2 cell=ivec2(floor((p-bodies[body].xy)/bodies[body+4].z));
    ivec2 size=ivec2(bodies[body+1].w,bodies[body+2].w);
    if(any(lessThan(cell,ivec2(0))) || any(greaterThanEqual(cell,size)))return -1;
    return int(bodies[body+3].w)+cell.y*size.x+cell.x;
}
void main(){
    ivec4 window=ivec4(window_config);int at=int(gl_GlobalInvocationID.x);
    if(at>=window.z*window.z)return;
    vec2 p=(vec2(window.xy+ivec2(at%window.z,at/window.z))+.5)*.25;
    int body=window.w*5;
    ivec2 cell=ivec2(floor((p-bodies[body].xy)/bodies[body+4].z));
    ivec2 size=ivec2(bodies[body+1].w,bodies[body+2].w);
    vec4 c=vec4(0),h=vec4(.75,0,0,0);
    if(all(greaterThanEqual(cell,ivec2(0))) && all(lessThan(cell,size))){
        int source=int(bodies[body+3].w)+cell.y*size.x+cell.x;
        c=coast[source];h=hydraulics[source];
    }
    // Fill the selected field's gaps with wet cells at a compatible height.
    // Actual dry cells remain barriers; overlapping fields prefer the selected one.
    if(c.x<.5) {
        float closest=.50001;
        for(int i=0;i<water_body_count;++i) {
            if(i==window.w)continue;
            int candidate=water_baked_cell(p,i);
            if(candidate<0 || coast[candidate].x<.5)continue;
            float difference=abs(coast[candidate].x-512.-water_sim_height);
            if(difference<=.5 && difference<closest) {
                c=coast[candidate];h=hydraulics[candidate];closest=difference;
            }
        }
    }
    c.z=max(c.z,smoothstep(float(window.z)*.25*.375,float(window.z)*.25*.484375,length(p-(vec2(window.xy)+float(window.z)*.5)*.25)));
    ivec2 world=window.xy+ivec2(at%window.z,at/window.z);
    ivec2 physical=world & ivec2(window.z-1);
    int slot=physical.y*window.z+physical.x;
    ivec2 previous=world-ivec2(previous_window);
    bool retained=initialize_history==0 && all(greaterThanEqual(previous,ivec2(0)))
                  && all(lessThan(previous,ivec2(window.z)));
    if(retained) {
        vec4 old=local_coast[slot];
        retained=old.x>.5 && c.x>.5 && abs(old.x-c.x)<=.5;
    }
    if(!retained) {
        float marker=.5+.25*sin(dot(p,vec2(1.7,.9)))+.25*sin(dot(p,vec2(-.8,2.1)));
        vec4 initial=c.x>.5?vec4(0,h.x*h.yz*water_current_scale,marker):vec4(0);
        state_a[slot]=initial;state_b[slot]=initial;
    }
    // Static metadata uses the same physical torus slots as history, so the
    // next window can validate a cell without moving or duplicating metadata.
    local_coast[slot]=c;local_hydraulics[slot]=h;
}
