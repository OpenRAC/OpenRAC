#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
// Animate only the small original vertex set, not each dense water vertex.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer CoarseWater { uvec4 coarse[]; };
uniform int triangle_count;
void main() {
    uint triangle = gl_GlobalInvocationID.x;
    if (triangle >= uint(triangle_count)) return;
    uint first = triangle * 7u;
    uvec4 params = coarse[first + 6u];
    vec4 motion = vec4(uintBitsToFloat(params.xyz), float(params.w & 511u));
    for (uint i = 0u; i < 3u; ++i) {
        vec3 p = uintBitsToFloat(coarse[first + i * 2u].xyz);
        vec2 uv = uintBitsToFloat(coarse[first + i * 2u + 1u].xy);
        if ((params.w & 0x80000000u) != 0u) uv = water_authored_uv(p, uv, motion);
        coarse[first + i * 2u + 1u].zw = floatBitsToUint(uv);
    }
}
