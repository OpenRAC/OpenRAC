// Reconstructs the Gaussian pyramid with a small bilinear tent contribution from the next level.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 0) writeonly buffer BloomOutput { uint pixels[]; };
uniform sampler2D tex_T0;
uniform sampler2D tex_T1;
uniform vec2 output_size;
uniform float scatter;

void main() {
    ivec2 size = ivec2(output_size);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) {
        return;
    }

    vec3 high = texelFetch(tex_T0, p, 0).rgb;
    vec2 uv = (vec2(p) + 0.5) / output_size;
    vec2 texel = 0.5 / vec2(textureSize(tex_T1, 0));
    vec3 low = texture(tex_T1, uv + vec2(-texel.x, -texel.y)).rgb;
    low += texture(tex_T1, uv + vec2(texel.x, -texel.y)).rgb;
    low += texture(tex_T1, uv + vec2(-texel.x, texel.y)).rgb;
    low += texture(tex_T1, uv + vec2(texel.x, texel.y)).rgb;
    low *= 0.25;

    vec3 colour = clamp(high + low * scatter, 0.0, 1.0);
    pixels[p.y * size.x + p.x] = packUnorm4x8(vec4(colour, 1.0));
}
