#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
// One persistent rigid pose per attachment, shared by colour, depth and shadows.
layout(local_size_x=64) in;
layout(std430,binding=4) readonly buffer Anchors { vec4 anchors[]; };
layout(std430,binding=5) writeonly buffer Poses { vec4 poses[]; };
uniform samplerBuffer previous_poses;
uniform int attachment_count;
uniform vec2 response;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=uint(attachment_count)) return;
    vec4 anchor=anchors[i];
    bool matched;
    vec4 target=water_float_target(anchor.xyz,matched);
    int previous=int(anchor.w);
    if(matched && previous>=0 && texelFetch(previous_poses,previous*2).w!=0.) {
        vec4 old=texelFetch(previous_poses,previous*2+1);
        target=vec4(normalize(mix(old.xyz,target.xyz,response.y)),mix(old.w,target.w,response.x));
    }
    poses[i*2]=vec4(anchor.xyz,matched ? 1. : 0.);
    poses[i*2+1]=target;
}
