layout(local_size_x=64) in;
layout(std430,binding=4) writeonly buffer WaterLighting { vec4 water_lighting[]; };
uniform samplerBuffer water_coast;
uniform samplerBuffer water_bodies;
uniform int water_body_count;
uniform int water_light_count;
void main() {
    int at=int(gl_GlobalInvocationID.x);
    if (at>=water_light_count) return;
    int chosen=-1,local=0; ivec2 extent=ivec2(0),light_extent=ivec2(0);
    for (int b=0;b<water_body_count;++b) {
        extent=ivec2(texelFetch(water_bodies,b*5+1).w,texelFetch(water_bodies,b*5+2).w);
        light_extent=(extent+3)/4+1;
        int begin=int(texelFetch(water_bodies,b*5+4).w);
        if (at>=begin && at<begin+light_extent.x*light_extent.y) { chosen=b;local=at-begin;break; }
    }
    if (chosen<0) return;
    vec4 origin=texelFetch(water_bodies,chosen*5),normal=texelFetch(water_bodies,chosen*5+3);
    vec4 flow=texelFetch(water_bodies,chosen*5+4);
    ivec2 centre=min(ivec2(local%light_extent.x,local/light_extent.x)*4,extent-1),found=centre;
    float closest=1000.,rest=0.; int begin=int(normal.w);
    // Locate a wet receiver near each coarse node; outside nodes have zero interpolation weight.
    float centre_height=texelFetch(water_coast,begin+centre.y*extent.x+centre.x).x;
    if (centre_height>.5) {
        closest=0.;rest=centre_height-512.;
    } else {
        for (int y=-2;y<=2;++y) for (int x=-2;x<=2;++x) {
            float distance=float(x*x+y*y);
            // Keep the original scan order for equal-distance ties.
            if (distance>=closest || (x==0 && y==0)) continue;
            ivec2 p=centre+ivec2(x,y);
            if (any(lessThan(p,ivec2(0))) || any(greaterThanEqual(p,extent))) continue;
            float h=texelFetch(water_coast,begin+p.y*extent.x+p.x).x;
            if (h>.5) { closest=distance;found=p;rest=h-512.; }
        }
    }
    if (closest>999.) { water_lighting[at]=vec4(0,0,0,-1);return; }
    vec3 p=origin.xyz+vec3((vec2(found)+.5)*flow.z,rest);
    float left=abs(texelFetch(water_coast,begin+found.y*extent.x+max(found.x-1,0)).x);
    float right=abs(texelFetch(water_coast,begin+found.y*extent.x+min(found.x+1,extent.x-1)).x);
    float bottom=abs(texelFetch(water_coast,begin+max(found.y-1,0)*extent.x+found.x).x);
    float top=abs(texelFetch(water_coast,begin+min(found.y+1,extent.y-1)*extent.x+found.x).x);
    left=left>.5?left-512.:rest;right=right>.5?right-512.:rest;
    bottom=bottom>.5?bottom-512.:rest;top=top>.5?top-512.:rest;
    vec3 n=normalize(vec3(-(right-left)/(2.*flow.z),-(top-bottom)/(2.*flow.z),1));
    vec3 irradiance=vec3(3.14159265*.65);
    if (probe_mode!=0 && probe_receiver!=0) {
        vec3 sampled;
        if (sample_probe_irradiance(p,n,sampled)) irradiance=sampled;
    }
    // W is validity, not cached visibility; direct shadows are evaluated at the displaced fragment.
    water_lighting[at]=vec4(irradiance,1.);
}
