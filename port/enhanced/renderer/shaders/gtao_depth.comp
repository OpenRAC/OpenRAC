#version 430 core
// SPDX-License-Identifier: GPL-3.0-or-later
// Copyright (c) 2026 the OpenRAC contributors
// Keeps depth bounds instead of averaging foreground, background and empty pixels together.
layout(local_size_x = 8, local_size_y = 8) in;
layout(std430, binding = 12) buffer DepthHierarchy { vec2 bounds[]; };
uniform sampler2D tex_T0;
uniform int source_width;
uniform int source_height;
uniform int source_offset;
uniform int destination_offset;
uniform int first_level;

void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    ivec2 source_size = ivec2(source_width, source_height);
    ivec2 size = (source_size + 1) / 2;
    if (any(greaterThanEqual(cell, size))) {
        return;
    }
    vec2 range = vec2(1.0, 0.0);
    for (int y = 0; y < 2; ++y) {
        for (int x = 0; x < 2; ++x) {
            ivec2 tap = min(cell * 2 + ivec2(x, y), source_size - 1);
            vec2 previous = first_level != 0 ? vec2(texelFetch(tex_T0, tap, 0).r)
                                            : bounds[source_offset + tap.y * source_width + tap.x];
            range = vec2(min(range.x, previous.x), max(range.y, previous.y));
        }
    }
    bounds[destination_offset + cell.y * size.x + cell.x] = range;
}
