{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release with debug information",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo"}
    },
    {
      "name": "release-x86_64",
      "inherits": "release",
      "displayName": "Release for Intel Macs (a Mac with Apple silicon cross-builds it)",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "cacheVariables": {"CMAKE_OSX_ARCHITECTURES": "x86_64", "OPENRAC_STATIC_SDL": "ON"}
    },
    {
      "name": "release-universal",
      "inherits": "release",
      "displayName": "Release for Apple silicon and Intel Macs in one binary (arm64 and x86_64)",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "cacheVariables": {"CMAKE_OSX_ARCHITECTURES": "arm64;x86_64", "OPENRAC_STATIC_SDL": "ON"}
    },
    {
      "name": "xcode",
      "inherits": "base",
      "displayName": "An Xcode project, for those who work in Xcode (optional: the other presets need only the Command Line Tools)",
      "generator": "Xcode",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin"},
      "cacheVariables": {"OPENRAC_STATIC_SDL": "ON"}
    },
    {
      "name": "enhanced",
      "inherits": "release",
      "displayName": "Release with experimental Vulkan enhanced rendering",
      "cacheVariables": {"OPENRAC_ENHANCED_RENDERING": "ON"}
    },
    {
      "name": "standalone",
      "inherits": "base",
      "displayName": "What an installer carries: SDL3 built in, nothing of the system's to find",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "OPENRAC_STATIC_SDL": "ON",
        "OPENRAC_PORT_LTO": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "headless",
      "inherits": "base",
      "displayName": "No window (no SDL3): the runtime, the games, the tests",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "OPENRAC_PORT_WINDOW": "OFF"}
    },
    {
      "name": "android-arm64",
      "displayName": "Android, arm64-v8a, API 28 and later, with the NDK at $ANDROID_NDK_HOME (tools/build_android.py)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "ANDROID_STL": "c++_shared",
        "OPENRAC_PORT_LTO": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "release-x86_64", "configurePreset": "release-x86_64"},
    {"name": "release-universal", "configurePreset": "release-universal"},
    {"name": "xcode", "configurePreset": "xcode", "configuration": "RelWithDebInfo"},
    {"name": "enhanced", "configurePreset": "enhanced"},
    {"name": "standalone", "configurePreset": "standalone"},
    {"name": "debug", "configurePreset": "debug"},
    {"name": "headless", "configurePreset": "headless"},
    {"name": "android-arm64", "configurePreset": "android-arm64"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "enhanced", "configurePreset": "enhanced", "output": {"outputOnFailure": true}},
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "headless", "configurePreset": "headless", "output": {"outputOnFailure": true}}
  ]
}
