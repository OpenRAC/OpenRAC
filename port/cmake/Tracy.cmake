# Optional development dependency; no download or link in ordinary builds.
include_guard(GLOBAL)
option(OPENRAC_TRACY "Build Tracy CPU and Vulkan GPU instrumentation" OFF)
option(OPENRAC_TRACY_SYSTEM "Enable Tracy system tracing (may require elevated privileges)" OFF)
option(OPENRAC_TRACY_SAMPLING "Enable Tracy sampling (requires system tracing)" OFF)
if(NOT OPENRAC_TRACY)
  return()
endif()
if(OPENRAC_TRACY_SAMPLING AND NOT OPENRAC_TRACY_SYSTEM)
  message(FATAL_ERROR "OPENRAC_TRACY_SAMPLING requires OPENRAC_TRACY_SYSTEM")
endif()
include(FetchContent)
set(TRACY_ENABLE ON CACHE BOOL "" FORCE)
set(TRACY_STATIC ON CACHE BOOL "" FORCE)
set(TRACY_ON_DEMAND ON CACHE BOOL "" FORCE)
set(TRACY_NO_CRASH_HANDLER ON CACHE BOOL "" FORCE)
if(OPENRAC_TRACY_SYSTEM)
  set(TRACY_NO_SYSTEM_TRACING OFF CACHE BOOL "" FORCE)
else()
  set(TRACY_NO_SYSTEM_TRACING ON CACHE BOOL "" FORCE)
endif()
if(OPENRAC_TRACY_SAMPLING)
  set(TRACY_NO_SAMPLING OFF CACHE BOOL "" FORCE)
else()
  set(TRACY_NO_SAMPLING ON CACHE BOOL "" FORCE)
endif()
set(openrac_tracy_options)
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.25)
  list(APPEND openrac_tracy_options SYSTEM)
endif()
if(CMAKE_VERSION VERSION_GREATER_EQUAL 3.28)
  list(APPEND openrac_tracy_options EXCLUDE_FROM_ALL)
endif()
FetchContent_Declare(tracy
  GIT_REPOSITORY https://github.com/wolfpld/tracy.git
  GIT_TAG 30997d5ca6bb632cc10807a1da8a6d3de0aeeb3c
  ${openrac_tracy_options})
FetchContent_MakeAvailable(tracy)
target_link_libraries(openrac_common PUBLIC Tracy::TracyClient)
target_compile_definitions(openrac_common PUBLIC OPENRAC_TRACY=1)

configure_file("${tracy_SOURCE_DIR}/LICENSE" "${CMAKE_BINARY_DIR}/licenses/tracy/LICENSE" COPYONLY)
