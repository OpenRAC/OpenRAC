#
# openrac_windows_version_info(<target> <description>): gives a Windows program or library a
# version resource (the Details tab of its Properties: name, version, company, licence). Files
# without one look odd to antivirus heuristics. The version is the launcher's (tauri.conf.json).
# Does nothing on other systems.

set(OPENRAC_TAURI_CONF "${PROJECT_SOURCE_DIR}/../launcher/src-tauri/tauri.conf.json")

function(openrac_windows_version_info target description)
  if(NOT WIN32)
    return()
  endif()
  set(version "0.0.0")
  if(EXISTS "${OPENRAC_TAURI_CONF}")
    set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                 "${OPENRAC_TAURI_CONF}")
    file(READ "${OPENRAC_TAURI_CONF}" json)
    string(JSON found ERROR_VARIABLE no_version GET "${json}" version)
    if(NOT no_version)
      set(version "${found}")
    endif()
  endif()
  # X.Y.Z (a -dev suffix dropped) as the four numbers Windows keeps.
  string(REGEX MATCH "^([0-9]+)\\.([0-9]+)\\.([0-9]+)" _ "${version}")
  set(numbers "0,0,0,0")
  if(CMAKE_MATCH_COUNT EQUAL 3)
    set(numbers "${CMAKE_MATCH_1},${CMAKE_MATCH_2},${CMAKE_MATCH_3},0")
  endif()
  get_target_property(type ${target} TYPE)
  if(type STREQUAL "SHARED_LIBRARY")
    set(file_type "0x2L")  # VFT_DLL
  else()
    set(file_type "0x1L")  # VFT_APP
  endif()
  get_target_property(name ${target} OUTPUT_NAME)
  if(NOT name)
    set(name "${target}")
  endif()
  if(type STREQUAL "SHARED_LIBRARY")
    set(file_name "${name}.dll")
  else()
    set(file_name "${name}.exe")
  endif()
  set(rc "${CMAKE_BINARY_DIR}/generated/version_info/${target}.rc")
  file(CONFIGURE OUTPUT "${rc}" @ONLY CONTENT "// Generated by cmake/WindowsVersionInfo.cmake.
// 1 is VS_VERSION_INFO; no #include, so no Windows SDK headers are needed.
1 VERSIONINFO
FILEVERSION @numbers@
PRODUCTVERSION @numbers@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE @file_type@
FILESUBTYPE 0x0L
BEGIN
  BLOCK \"StringFileInfo\"
  BEGIN
    BLOCK \"040904b0\"
    BEGIN
      VALUE \"CompanyName\", \"OpenRAC contributors\"
      VALUE \"FileDescription\", \"@description@\"
      VALUE \"FileVersion\", \"@version@\"
      VALUE \"InternalName\", \"@name@\"
      VALUE \"LegalCopyright\", \"Copyright (c) 2026 the OpenRAC contributors. GPL-3.0-or-later.\"
      VALUE \"OriginalFilename\", \"@file_name@\"
      VALUE \"ProductName\", \"OpenRAC\"
      VALUE \"ProductVersion\", \"@version@\"
      VALUE \"Comments\", \"https://github.com/OpenRAC/OpenRAC\"
    END
  END
  BLOCK \"VarFileInfo\"
  BEGIN
    VALUE \"Translation\", 0x409, 1200
  END
END
")
  target_sources(${target} PRIVATE "${rc}")
endfunction()
