//
// HDR output's one pass (common/hdr.h, the same arithmetic on the CPU): the default framebuffer's
// picture, scaled to the screen as the SDR blit scales it and turned the right way up, written
// into the swapchain's image as PQ in BT.2020 (OPENRAC_HDR_PQ) or as scRGB. The game's white lands
// at the player's paper white; only what the HDR frame's blending added up above white goes
// beyond it, rolled off towards the peak.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D picture;  // row 0 at the bottom, as in GL
#ifdef OPENRAC_HDR_PQ
layout(binding = 1, rgb10_a2) writeonly uniform image2D screen;
#else
layout(binding = 1, rgba16f) writeonly uniform image2D screen;
#endif

layout(push_constant) uniform Encode {
    float paper_white;  // nits of the game's white
    float sdr_gamma;    // the picture's bytes to linear light (common/hdr.h, kSdrGamma)
    int same_size;      // 1: one texel a pixel, read as it is (the blit's NEAREST)
    float headroom;     // peak / paper white - 1: how far light above white rolls off to
    // How light above white looks (common/hdr.h, Look); `plain` is 1 for the defaults.
    float highlights;
    float sdr_hue;
    float sdr_chroma;
    float blowout;
    int plain;
} encode;

vec3 pq(vec3 nits) {
    const float m1 = 2610.0 / 16384.0;
    const float m2 = 2523.0 / 4096.0 * 128.0;
    const float c1 = 3424.0 / 4096.0;
    const float c2 = 2413.0 / 4096.0 * 32.0;
    const float c3 = 2392.0 / 4096.0 * 32.0;
    vec3 y = pow(clamp(nits / 10000.0, 0.0, 1.0), vec3(m1));
    return pow((c1 + c2 * y) / (1.0 + c3 * y), vec3(m2));
}

// Light above white rolled off towards the peak (common/hdr.h, roll_off_above_white).
vec3 roll_off(vec3 linear) {
    float m = max(linear.r, max(linear.g, linear.b));
    if (m > 1.0) {
        float h = encode.headroom;
        float to = h > 0.0 ? 1.0 + h * (1.0 - exp(-(m - 1.0) / h)) : 1.0;
        linear *= to / m;
    }
    return linear;
}

// OKLab (common/hdr.h, linear_to_oklab and oklab_to_linear).
vec3 oklab(vec3 c) {
    vec3 lms = transpose(mat3(
        0.4122214708, 0.5363325363, 0.0514459929,
        0.2119034982, 0.6806995451, 0.1073969566,
        0.0883024619, 0.2817188376, 0.6299787005)) * c;
    lms = pow(max(lms, vec3(0.0)), vec3(1.0 / 3.0));
    return transpose(mat3(
        0.2104542553, 0.7936177850, -0.0040720468,
        1.9779984951, -2.4285922050, 0.4505937099,
        0.0259040371, 0.7827717662, -0.8086757660)) * lms;
}

vec3 from_oklab(vec3 lab) {
    vec3 lms = transpose(mat3(
        1.0, 0.3963377774, 0.2158037573,
        1.0, -0.1055613458, -0.0638541728,
        1.0, -0.0894841775, -1.2914855480)) * lab;
    lms = lms * lms * lms;
    return transpose(mat3(
        4.0767416621, -3.3077115913, 0.2309699292,
        -1.2684380046, 2.6097574011, -0.3413193965,
        -0.0041960863, -0.7034186147, 1.7076127119)) * lms;
}

// The look on light above white (common/hdr.h, apply_look).
vec3 apply_look(vec3 hdr, vec3 sdr) {
    const float grey_chroma = 1e-4;
    vec3 lab = oklab(hdr);
    vec3 ref = oklab(sdr);
    float chroma = length(lab.yz);
    float ref_chroma = length(ref.yz);
    vec2 dir = chroma > grey_chroma ? lab.yz / chroma : vec2(0.0);
    if (ref_chroma > grey_chroma) {
        vec2 to = ref.yz / ref_chroma;
        if (chroma <= grey_chroma) {
            dir = to;
        } else if (encode.sdr_hue > 0.0) {
            vec2 turned = mix(dir, to, encode.sdr_hue);
            float len = length(turned);
            if (len > grey_chroma) {
                dir = turned / len;
            }
        }
    }
    float c = mix(chroma, ref_chroma, encode.sdr_chroma);
    float y = dot(hdr, vec3(0.2126, 0.7152, 0.0722));
    if (y > 1.0) {
        c *= 1.0 + (1.0 / y - 1.0) * encode.blowout;
    }
    vec3 result = from_oklab(vec3(lab.x, dir * c));
    // Inside BT.709: towards grey of the same lightness.
    float grey = lab.x * lab.x * lab.x;
    float keep = 1.0;
    for (int i = 0; i < 3; ++i) {
        if (result[i] < 0.0) {
            keep = min(keep, grey / (grey - result[i]));
        }
    }
    result = max(vec3(grey) + (result - vec3(grey)) * keep, vec3(0.0));
    // Never past the peak.
    float top = encode.headroom > 0.0 ? 1.0 + encode.headroom : 1.0;
    float m = max(result.r, max(result.g, result.b));
    if (m > top) {
        result *= top / m;
    }
    return result;
}

void main() {
    ivec2 size = imageSize(screen);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    // The screen's row 0 is its top; the picture's is its bottom.
    vec3 sdr;
    if (encode.same_size != 0) {
        sdr = texelFetch(picture, ivec2(pixel.x, size.y - 1 - pixel.y), 0).rgb;
    } else {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
        sdr = textureLod(picture, vec2(uv.x, 1.0 - uv.y), 0.0).rgb;
    }
    // Above 1 where the HDR frame's blending added up past white (common/hdr.h, to_light).
    vec3 linear = pow(max(sdr, vec3(0.0)), vec3(encode.sdr_gamma));
    // The SDR range stays as it is; light above white is rolled off and given the look.
    if (max(linear.r, max(linear.g, linear.b)) > 1.0) {
        if (encode.plain != 0) {
            linear = roll_off(linear);
        } else {
            // The pixel as SDR shows it: each channel clipped at white.
            vec3 clipped = pow(clamp(sdr, 0.0, 1.0), vec3(encode.sdr_gamma));
            if (encode.highlights < 1.0) {
                linear = clipped + (linear - clipped) * encode.highlights;
            }
            linear = apply_look(roll_off(linear), clipped);
        }
    }
#ifdef OPENRAC_HDR_PQ
    // Linear BT.709 to BT.2020 (GLSL's mat3 takes columns: these are common/hdr.h's rows).
    const mat3 to2020 = transpose(mat3(
        0.627403896, 0.329283038, 0.043313066,
        0.069097289, 0.919540395, 0.011362316,
        0.016391439, 0.088013308, 0.895595253));
    imageStore(screen, pixel, vec4(pq(to2020 * linear * encode.paper_white), 1.0));
#else
    imageStore(screen, pixel, vec4(linear * (encode.paper_white / 80.0), 1.0));
#endif
}
